# Local PostgreSQL connection; use separate credentials outside local development.
# 本地 PostgreSQL 连接；在本地开发以外的环境中使用独立凭据。
DATABASE_URL=postgresql+psycopg://seo_tool:seo_tool_dev@localhost:5432/seo_tool

# Allowed browser origins, encoded as a JSON list.
# 允许的浏览器来源，以 JSON 列表形式配置。
CORS_ORIGINS=["http://localhost:3000"]
